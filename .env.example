# ============================================================
# .env.example — Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it contains your secrets
# ============================================================

# ── Anthropic API (Claude AI) ────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Email Notifications ──────────────────────────────────────
# Your Gmail address (receives application confirmations)
NOTIFY_EMAIL=you@gmail.com
CANDIDATE_EMAIL=you@gmail.com

# Gmail App Password (NOT your main password)
# Get one at: https://myaccount.google.com/apppasswords
# App: Mail | Device: Mac | Click Generate
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Your Contact Info (used in application forms) ────────────
HOME_PHONE=5551234567
HOME_ADDRESS=123 Your Street Apt 1
HOME_CITY=Your City
HOME_CITY_STATE=Your City, ST
HOME_ZIP=12345

# ── Workday Account Password ─────────────────────────────────
# Used to create and log into per-company Workday accounts
# Pick a strong password you're OK using across companies
WORKDAY_PASSWORD=YourWorkdayPassword123!

# ── Workday Security Questions ───────────────────────────────
# Pre-set answers for common security questions Workday may ask.
# The pipeline reads these and auto-fills — no human needed.
# Keep answers short, memorable, and consistent.
SECURITY_Q_FIRST_PET=Buddy
SECURITY_Q_MOTHERS_MAIDEN=Smith
SECURITY_Q_BIRTH_CITY=Hyderabad
SECURITY_Q_ELEMENTARY_SCHOOL=Springfield
SECURITY_Q_CHILDHOOD_NICKNAME=Raghu
SECURITY_Q_FIRST_CAR=Honda
SECURITY_Q_FAVORITE_TEACHER=Kumar
SECURITY_Q_CHILDHOOD_FRIEND=Arjun
SECURITY_Q_FIRST_JOB=Intern
SECURITY_Q_FAVORITE_SPORTS_TEAM=Lakers

# ── Optional Claude Model Override ──────────────────────────
# Default is claude-haiku-4-5-20251001 (fast + cheap)
# Use claude-sonnet-4-6 for higher quality (costs more)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
